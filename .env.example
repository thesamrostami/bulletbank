# ============================================================
# BulletBank — Environment Variables
# Copy this to .env.local and fill in your values
# NEVER commit .env.local to git
# ============================================================

# Supabase — get from: supabase.com > your project > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Service role key — server-only, NEVER prefix with NEXT_PUBLIC_
# Required for full account deletion (removes the auth.users record)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Anthropic — get from: console.anthropic.com > API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Firecrawl — optional, enables URL-based job extraction (firecrawl.dev > API Keys)
FIRECRAWL_API_KEY=fc-your-key-here

# Cloudflare Turnstile CAPTCHA (optional but recommended)
# 1. Get site key at: dash.cloudflare.com > Turnstile > Add site
# 2. Paste the secret key into Supabase: Authentication → Sign In / Up → CAPTCHA protection → Turnstile
# 3. Add site key here (public — safe to expose)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key-here

# Lemon Squeezy — get from: app.lemonsqueezy.com > Settings > API
# 1. Create a store and 3 products (Starter £3/50cr, Standard £6/120cr, Pro £12/300cr)
# 2. Each product is a one-time payment. Note the variant ID for each.
# 3. Create a webhook pointing to /api/webhooks/lemonsqueezy with event: order_created
LEMONSQUEEZY_API_KEY=your-api-key-here
LEMONSQUEEZY_STORE_ID=your-store-id-here
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-signing-secret-here
LEMONSQUEEZY_STARTER_VARIANT_ID=variant-id-for-100-credits
LEMONSQUEEZY_STANDARD_VARIANT_ID=variant-id-for-250-credits
LEMONSQUEEZY_PRO_VARIANT_ID=variant-id-for-600-credits

# Canonical app URL — required when running behind a reverse proxy (e.g. Docker + Traefik/Nginx).
# If omitted, the app defaults to the incoming request origin. Always set this in production.
# Example: https://yourdomain.com
NEXT_PUBLIC_APP_URL=

# Analytics — optional, omit to disable tracking entirely
# Google Analytics: analytics.google.com > Admin > Data Streams > your stream > Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Microsoft Clarity: clarity.microsoft.com > your project > Settings > Overview > Tracking Code (the ID in the snippet)
NEXT_PUBLIC_CLARITY_ID=your-clarity-project-id
